// calculator.nil — NilLang advanced calculator
// Demonstrates: match, recursion, string operations, error handling
// Run: nilc -in examples/calculator/main.nil -run

function calc(a: i32, b: i32, op: string): i32 {
    match op {
        "+" => { return a + b }
        "-" => { return a - b }
        "*" => { return a * b }
        "/" => {
            if b == 0 {
                print("Error: division by zero!")
                return 0
            }
            return a / b
        }
        "%" => {
            if b == 0 {
                print("Error: modulo by zero!")
                return 0
            }
            return a % b
        }
    }
    print("Unknown operator: " + op)
    return 0
}

function isPrime(n: i32): bool {
    if n < 2 {
        return false
    }
    if n == 2 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    let i: i32 = 3
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i = i + 2
    }
    return true
}

function gcd(a: i32, b: i32): i32 {
    while b != 0 {
        let temp: i32 = b
        b = a % b
        a = temp
    }
    return a
}

function lcm(a: i32, b: i32): i32 {
    return a / gcd(a, b) * b
}

function power(base: i32, exp: i32): i32 {
    if exp == 0 {
        return 1
    }
    if exp == 1 {
        return base
    }
    if exp % 2 == 0 {
        let half: i32 = power(base, exp / 2)
        return half * half
    }
    return base * power(base, exp - 1)
}

function abs(n: i32): i32 {
    if n < 0 {
        return 0 - n
    }
    return n
}

function max(a: i32, b: i32): i32 {
    if a > b { return a }
    return b
}

function min(a: i32, b: i32): i32 {
    if a < b { return a }
    return b
}

function main(): void {
    print("=== NilLang Calculator ===")
    print("")

    // Basic operations
    print("--- Basic Arithmetic ---")
    let ops: string[] = ["+", "-", "*", "/", "%"]
    let i: i32 = 0
    while i < ops.length {
        let op: string = ops[i]
        let result: i32 = calc(17, 5, op)
        print("17 " + op + " 5 = " + result.toString())
        i = i + 1
    }

    print("")
    print("--- Powers ---")
    let j: i32 = 0
    while j <= 10 {
        print("2^" + j.toString() + " = " + power(2, j).toString())
        j = j + 1
    }

    print("")
    print("--- Prime Numbers up to 50 ---")
    let primes: string = ""
    let k: i32 = 2
    while k <= 50 {
        if isPrime(k) {
            if primes == "" {
                primes = k.toString()
            } else {
                primes = primes + ", " + k.toString()
            }
        }
        k = k + 1
    }
    print(primes)

    print("")
    print("--- GCD & LCM ---")
    print("gcd(48, 18) = " + gcd(48, 18).toString())
    print("lcm(4, 6)   = " + lcm(4, 6).toString())
    print("gcd(100, 75) = " + gcd(100, 75).toString())
    print("lcm(12, 18)  = " + lcm(12, 18).toString())

    print("")
    print("--- Min/Max/Abs ---")
    print("max(42, 17) = " + max(42, 17).toString())
    print("min(42, 17) = " + min(42, 17).toString())
    print("abs(-99)    = " + abs(-99).toString())

    print("")
    print("=== Done ===")
}

main()
